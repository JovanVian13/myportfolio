datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// ==========================================
// ENUMS (Strict types for categorization)
// ==========================================

enum SkillCategory {
  FRONTEND
  BACKEND
  DEVOPS
  TOOLS
}

// ==========================================
// MODELS (Database Tables)
// ==========================================

model Skill {
  id          String        @id @default(uuid())
  name        String        @unique // e.g., "React Js", "NestJS"
  category    SkillCategory // Restricts input to the enum values above
  iconName    String // For UI icon mapping (e.g., "SiReact", "SiNestjs")
  sortOrder   Int           @default(0) // Display order within a category
  projects    Project[] // Implicit many-to-many with Project
  experiences Experience[] // Implicit many-to-many with Experience
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("skills") // Keeps database table names lowercase plural
}

model Experience {
  id          String    @id @default(uuid())
  company     String // e.g., "Tech Corp"
  role        String // e.g., "Full-Stack Intern"
  location    String? // e.g., "Remote" or "New York, NY"
  startDate   DateTime
  endDate     DateTime? // Null means "Present" / Currently working here
  description String[] // Postgres native string array for bullet points
  skills      Skill[] // Skills used in this role
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("experiences")
}

model Education {
  id           String   @id @default(uuid())
  institution  String // e.g., "University of Computer Science"
  degree       String // e.g., "Bachelor of Science"
  fieldOfStudy String // e.g., "Information Technology"
  startDate    DateTime
  endDate      DateTime
  description  String? // Optional extra details (e.g., GPA, societies)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("educations")
}

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique // URL-friendly id, e.g., "e-commerce-app"
  title       String // e.g., "E-Commerce App"
  description String // Markdown or plain text description
  skills      Skill[] // Tech stack, linked to the skills table
  imageUrl    String? // URL string pointing to your Cloudinary storage
  githubUrl   String? // Link to source code
  liveUrl     String? // Link to live hosted site
  featured    Boolean  @default(false) // Toggle to pin projects to the top
  published   Boolean  @default(false) // Drafts stay hidden from the public site
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

// Single-row table: the API only ever reads/upserts id = 1
model Profile {
  id          Int      @id @default(1)
  fullName    String
  headline    String // e.g., "Full-Stack Developer"
  bio         String // Markdown
  avatarUrl   String?
  resumeUrl   String?
  email       String?
  location    String?
  githubUrl   String?
  linkedinUrl String?
  updatedAt   DateTime @updatedAt

  @@map("profile")
}
